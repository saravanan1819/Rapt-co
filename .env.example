# Copy to .env.local for local work. In production, set these in
# Vercel Project Settings OR Hostinger Web App → Environment Variables.
# Never expose keys via VITE_ variables; they must remain server-side.
# Never commit real values.

# --- Consultation email (server-side only; Vercel contact function or Hostinger Express) ---
# Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=
# Recipient is fixed in code to info@theraptconsulting.com. Do not set CONTACT_TO_EMAIL.
# Sender shown on enquiry emails. Must be on a domain verified in Resend,
# e.g. "RAPT & Co. Website <website@your-domain>". If empty, Resend's test sender is used,
# which only delivers to the Resend account owner's own address.
CONTACT_FROM_EMAIL=

# --- Public site URL (build-time; exposed to the browser, not a secret) ---
# Confirmed production origin, no trailing slash, e.g. https://www.example.com
# Enables canonical URLs, og:url and sitemap.xml. Leave empty until the domain is confirmed.
VITE_SITE_URL=

# --- Hostinger staging runtime (not relevant to Vercel) ---
# Keep true on a temporary deployment. Production must explicitly set false.
RAPT_STAGING=true
